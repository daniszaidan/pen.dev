                          "layout": "none"
                        },
                        {
                          "type": "text",
                          "id": "sSrB1",
                          "name": "A developer’s mind. A designer’s heart.",
                          "context": "h2",
                          "fill": "#eeeee8",
                          "content": "A developer’s mind.\nA designer’s heart.",
                          "lineHeight": 1.08,
                          "fontFamily": "DM Sans",
                          "fontSize": 54.72,
                          "fontWeight": "500",
                          "letterSpacing": -3.56
                        },
                        {
                          "type": "frame",
                          "id": "kJKpG",
                          "name": "spacer",
                          "width": "fill_container",
                          "height": 25,
                          "layout": "none"
                        },
                        {
                          "type": "text",
                          "id": "IUSzc",
                          "name": "I build digital experiences that look co",
                          "context": "p",
                          "fill": "#eeeee8",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 72.19,
                          "content": "I build digital experiences that look considered, feel intuitive, and work beautifully.",
                          "lineHeight": 1.9,
                          "fontFamily": "DM Sans",
                          "fontSize": 19,
                          "fontWeight": "normal",
                          "letterSpacing": -0.38
                        },
                        {
                          "type": "frame",
                          "id": "FNBKs",
                          "name": "spacer",
                          "width": "fill_container",
                          "height": 19.99,
                          "layout": "none"
                        },
                        {
                          "type": "text",
                          "id": "Wlbmz",
                          "name": "It started with Blogger templates in hig",
                          "context": "p",
                          "fill": "#a0a594",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 49.4,
                          "content": "It started with Blogger templates in high school. A little HTML, a little CSS, and a lot of “what happens if I change this?” That curiosity became a career in frontend development and a lasting love for design.",
                          "lineHeight": 1.9,
                          "fontFamily": "DM Sans",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "P7pkn",
                          "name": "spacer",
                          "width": "fill_container",
                          "height": 20,
                          "layout": "none"
                        },
                        {
                          "type": "text",
                          "id": "zJ70l",
                          "name": "With 5+ years in the industry, I work ac",
                          "context": "p",
                          "fill": "#a0a594",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 74.09,
                          "content": "With 5+ years in the industry, I work across React and Next.js applications, UI/UX design, and visual identities. I enjoy making complex things easier to understand—and finding the unexpected detail that makes them memorable.",
                          "lineHeight": 1.9,
                          "fontFamily": "DM Sans",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "B7Id4",
                          "name": "spacer",
                          "width": "fill_container",
                          "height": 35,
                          "layout": "none"
                        },
