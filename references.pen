              "children": [
                {
                  "type": "text",
                  "id": "vltCq",
                  "x": 0,
                  "y": 0,
                  "name": "That high-school curiosity grew into a c",
                  "context": "p",
                  "fill": "#62695e",
                  "textGrowth": "fixed-width-height",
                  "width": 369.18,
                  "height": 91.17,
                  "content": "That high-school curiosity grew into a career in frontend development and a lasting love for UI/UX design. Today, I work across React and Next.js applications, visual identities, and the details that make interfaces feel intuitive.",
                  "lineHeight": 1.9,
                  "fontFamily": "DM Sans",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "wciEN",
                  "x": 404.17,
                  "y": 0,
                  "name": "Over 5+ years, I’ve worked with designer",
                  "context": "p",
                  "fill": "#62695e",
                  "textGrowth": "fixed-width-height",
                  "width": 369.19,
                  "height": 91.17,
                  "content": "Over 5+ years, I’ve worked with designers, engineers, analysts, and product teams. I like connecting their different perspectives—and keeping the person using the product at the centre of the conversation.",
                  "lineHeight": 1.9,
                  "fontFamily": "DM Sans",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
