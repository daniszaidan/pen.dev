              "children": [
                {
                  "type": "text",
                  "id": "Wc447",
                  "name": "01 / MY STORY",
                  "context": "p",
                  "fill": "#a0a594",
                  "content": "01 / MY STORY",
                  "lineHeight": 1.6,
                  "fontFamily": "IBM Plex Mono",
