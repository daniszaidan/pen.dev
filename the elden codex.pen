            },
            {
              "type": "text",
              "id": "cUdiM",
              "x": 132,
              "y": 146,
              "name": "Story Headline",
              "fill": "#efebe2",
              "textGrowth": "fixed-width-height",
              "width": 1100,
              "height": 180,
              "content": "A crown is\nnever given.",
              "lineHeight": 0.9,
              "fontFamily": "Cormorant Garamond",
              "fontSize": 92,
              "fontWeight": "normal",
              "letterSpacing": -2.8
            },
            {
              "type": "text",
              "id": "R1JC3",
              "x": 132,
              "y": 348,
              "name": "Story Introduction",
              "fill": "#b4aea2",
              "textGrowth": "fixed-width-height",
              "width": 1040,
              "height": 58,
              "content": "Collect two Great Runes and visit Roundtable Hold to earn your way into Leyndell. Godrick and Rennala are common choices; neither is individually mandatory.",
              "lineHeight": 1.8,
              "fontFamily": "Manrope",
              "fontSize": 17,
              "fontWeight": "normal"
            },
            {
              "type": "rectangle",
              "id": "wFrJr",
              "x": 132,
              "y": 430,
              "name": "Story Note Divider",
              "fill": "#dac49b29",
              "width": 1100,
              "height": 1
            },
            {
              "type": "text",
              "id": "VKEKc",
              "x": 132,
              "y": 453,
              "name": "Route Note Eyebrow",
              "fill": "#c4ab7d",
              "textGrowth": "fixed-width-height",
              "width": 900,
              "height": 22,
              "content": "EIGHT ENCOUNTERS, ONE THRONE",
              "lineHeight": 1.55,
              "fontFamily": "Manrope",
              "fontSize": 13,
              "fontWeight": "normal",
              "letterSpacing": 1.5
            },
            {
              "type": "text",
              "id": "YhmsT",
              "x": 132,
              "y": 492,
              "name": "Required Encounters — I",
              "fill": "#eeeae0",
              "textGrowth": "fixed-width-height",
              "width": 515,
              "height": 128,
              "content": "01  Godfrey, First Elden Lord\n02  Morgott, the Omen King\n03  Fire Giant\n04  Godskin Duo",
              "lineHeight": 1.9,
              "fontFamily": "Manrope",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "CTi0F",
              "x": 710,
              "y": 492,
              "name": "Required Encounters — II",
              "fill": "#eeeae0",
              "textGrowth": "fixed-width-height",
              "width": 525,
              "height": 128,
              "content": "05  Maliketh, the Black Blade\n06  Sir Gideon Ofnir\n07  Godfrey / Hoarah Loux\n08  Radagon & the Elden Beast",
              "lineHeight": 1.9,
              "fontFamily": "Manrope",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "Qj1zY",
              "x": 132,
              "y": 646,
              "name": "Route Detail",
              "fill": "#b4aea2",
              "textGrowth": "fixed-width-height",
              "width": 1100,
              "height": 58,
              "content": "Before Leyndell, choose two from Godrick, Rennala, Radahn, Rykard, and Mohg. Their access routes differ: Godrick’s includes Margit; Rennala’s includes the Red Wolf of Radagon. The early Volcano Manor dungeon route includes the Godskin Noble.",
              "lineHeight": 1.65,
              "fontFamily": "Manrope",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "Q6SjUY",
              "x": 132,
              "y": 716,
              "name": "Capital Route",
              "fill": "#b4aea2",
              "textGrowth": "fixed-width-height",
              "width": 1100,
              "height": 48,
              "content": "The usual capital entrance is guarded by the Draconic Tree Sentinel. A Deeproot portal after Fia’s Champions is an alternative, so the sentinel is route-dependent.",
              "lineHeight": 1.65,
              "fontFamily": "Manrope",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "j13oe",
              "x": 132,
              "y": 806,
              "name": "Route Caution",
              "fill": "#9b9587",
              "textGrowth": "fixed-width-height",
              "width": 1100,
              "height": 46,
              "content": "This is the normal, glitchless base-game route. Radagon and the Elden Beast are two consecutive bosses, grouped as one final encounter.",
              "lineHeight": 1.6,
              "fontFamily": "Manrope",
              "fontSize": 14,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },
