                  "name": "This is a selection from that journey through Elden Ring.",
                  "fill": "#abafa4ff",
                  "textGrowth": "fixed-width",
                  "width": 660,
                  "content": "This is a selection from that journey through Elden Ring.",
                  "lineHeight": 1.7058823529411764,
