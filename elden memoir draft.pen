          "clip": true,
          "width": 1312,
          "gap": 48,
          "children": [
            {
              "type": "frame",
              "id": "QxnMA",
              "name": "01 / Photography first",
              "clip": true,
              "width": 405,
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "RK3nu",
                  "name": "01 / Photography first",
                  "fill": "#bca477ff",
                  "textGrowth": "fixed-width",
                  "width": 405,
                  "content": "01 / Photography first",
                  "lineHeight": 1.6363636363636365,
                  "fontFamily": "IBM Plex Mono",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "NX97i",
                  "name": "18 original screenshots selected from the supplied archive. Keep the c",
                  "fill": "#abafa4ff",
                  "textGrowth": "fixed-width",
                  "width": 405,
                  "content": "18 original screenshots selected from the supplied archive. Keep the character, game atmosphere, and in-game traces. No invented play statistics or personal memories.",
                  "lineHeight": 1.625,
                  "fontFamily": "Manrope",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "w5BShb",
              "name": "02 / Colour from the world",
              "clip": true,
              "width": 405,
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "uHSrL",
                  "name": "02 / Colour from the world",
                  "fill": "#bca477ff",
                  "textGrowth": "fixed-width",
                  "width": 405,
                  "content": "02 / Colour from the world",
                  "lineHeight": 1.6363636363636365,
                  "fontFamily": "IBM Plex Mono",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "hh5JR",
                  "name": "Charcoal and warm bone form the interface. Gold is restrained. Midnigh",
                  "fill": "#abafa4ff",
                  "textGrowth": "fixed-width",
                  "width": 405,
                  "content": "Charcoal and warm bone form the interface. Gold is restrained. Midnight blue supports the underground chapter; warm interiors provide the change in temperature.",
                  "lineHeight": 1.625,
                  "fontFamily": "Manrope",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "l4ryP",
              "name": "03 / Editorial rhythm",
              "clip": true,
              "width": 405,
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "fGxPU",
                  "name": "03 / Editorial rhythm",
                  "fill": "#bca477ff",
                  "textGrowth": "fixed-width",
                  "width": 405,
                  "content": "03 / Editorial rhythm",
                  "lineHeight": 1.6363636363636365,
                  "fontFamily": "IBM Plex Mono",
                  "fontSize": 11,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "vLKoA",
                  "name": "Large establishing views alternate with smaller observations. Four the",
                  "fill": "#abafa4ff",
                  "textGrowth": "fixed-width",
                  "width": 405,
                  "content": "Large establishing views alternate with smaller observations. Four thematic chapters replace encyclopedic categories. The archive is secondary to the journey.",
                  "lineHeight": 1.625,
                  "fontFamily": "Manrope",
                  "fontSize": 16,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "rectangle",
          "id": "U3a499",
          "name": "Hairline",
          "fill": "#42473fff",
          "width": 1312,
          "height": 1
        },
        {
          "type": "text",
          "id": "XCBXy",
          "name": "Prototype scope: journey navigation, chapter jumps, archive, and the “",
          "fill": "#abafa4ff",
          "textGrowth": "fixed-width",
          "width": 1312,
          "content": "Prototype scope: journey navigation, chapter jumps, archive, and the “The city below” photograph viewer. Other archive entries are visual references. Motion intent: short opacity reveals and gentle image transitions; retain native scrolling and support reduced motion. Final copy and photograph titles are editorial proposals for review.",
