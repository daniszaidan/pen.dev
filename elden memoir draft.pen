                },
                {
                  "type": "text",
                  "id": "zB4if",
                  "name": "I’m a frontend developer, designer, and photographer. When I play, I t",
                  "fill": "#e7e1d3ff",
                  "textGrowth": "fixed-width",
                  "width": 660,
                  "content": "I’m a frontend developer, designer, and photographer. When I play, I take screenshots with my character still in the frame—a way to keep the journey personal.",
