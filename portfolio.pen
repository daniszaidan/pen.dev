                        },
                        {
                          "type": "text",
                          "id": "k2iEH5",
                          "name": "I care about how things work, how they f",
                          "context": "p",
                          "fill": "$palette-21-dark-muted",
                          "textGrowth": "fixed-width-height",
                          "width": 455,
                          "height": 48.08,
                          "content": "I care about how things work, how they feel, and the people on the other side of the screen.",
