                        },
                        {
                          "type": "text",
                          "id": "l7xeHo",
                          "name": "I build digital experiences that look co",
                          "context": "p",
                          "fill": "$palette-10-dark-text",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 72.19,
                          "content": "I build digital experiences that look considered, feel intuitive, and work beautifully.",
                          "lineHeight": 1.9,
                          "fontFamily": "DM Sans",
                          "fontSize": 19,
                          "fontWeight": "normal",
                          "letterSpacing": -0.38
                        },
                        {
                          "type": "frame",
                          "id": "BeU7n",
