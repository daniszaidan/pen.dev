                        },
                        {
                          "type": "text",
                          "id": "i0mb4W",
                          "name": "I’m Danis Zaidan. My curiosity started w",
                          "context": "p",
                          "fill": "$palette-21-dark-muted",
                          "textGrowth": "fixed-width-height",
                          "width": 455,
                          "height": 72.13,
                          "content": "I’m Danis Zaidan. My curiosity started with tweaking Blogger templates. These days, it takes me from intricate dashboards to expressive digital experiences.",
                          "lineHeight": 1.85,
                          "fontFamily": "DM Sans",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
